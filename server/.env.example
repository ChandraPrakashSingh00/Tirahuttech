# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# URL of the deployed frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# Secret used to HMAC-hash visitor IPs before storing them
IPHASH_SECRET=change-me-to-a-long-random-string

# How long the visitor cookie should live, in milliseconds (default: 1 year)
COOKIE_MAX_AGE_MS=31536000000

# Optional: Google Sheets webhook mirroring for form submissions
SHEET_WEBHOOK_URL=
SHEET_SECRET=
ENQUIRY_SHEET_WEBHOOK_URL=
CAREER_SHEET_WEBHOOK_URL=
